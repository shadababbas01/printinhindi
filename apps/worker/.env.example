# Worker env reference ONLY — this file documents the required secret names.
# Do NOT put real values here and do NOT commit a filled-in version.
# Set every one of these with: wrangler secret put <NAME>
# Non-secret values (CASHFREE_ENV, APP_BASE_URL, etc.) live in wrangler.toml [vars].

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
